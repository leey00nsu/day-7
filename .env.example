# Set this to the public domain assigned to the application.
NEXT_PUBLIC_SITE_URL=https://game.example.com

# Required. Set this to the public base URL that contains the game videos.
NEXT_PUBLIC_VIDEO_BASE_URL=https://media.example.com/day-7-videos

# Local docker-compose PostgreSQL connection URL.
# Replace the host and credentials in production.
DATABASE_URL=postgresql://game_user:local_password@localhost:5432/game
